modules = ["nodejs-20", "web", "postgresql-16"]
[agent]
expertMode = true

[nix]
channel = "stable-25_05"

[workflows]
runButton = "Project"

[[workflows.workflow]]
name = "Project"
mode = "parallel"
author = "agent"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "Development Server"

[[workflows.workflow]]
name = "Development Server"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "npm run dev"
waitForPort = 5000

[workflows.workflow.metadata]
outputType = "webview"

[deployment]
deploymentTarget = "autoscale"
run = ["npm", "run", "start"]
build = ["npm", "run", "build"]

[userenv]

[userenv.shared]
VITE_REOWN_PROJECT_ID = "036eb83b8e45afb4b8e21366380f0aa0"
BSC_ESCROW_ADDRESS = "0x379ADe242CC712EBA77c2149F4cC48dD4d2778e9"
BSC_RPC_URL = "https://bsc-dataseed.binance.org"
BSC_CHAIN_ID = "56"
VITE_USE_MOCK_ESCROW = "false"
VITE_ESCROW_CHAIN_ID = "56"
VITE_BSC_ESCROW_ADDRESS = "0x379ADe242CC712EBA77c2149F4cC48dD4d2778e9"
SERVER_SESSION_WALLET = "0x2ad7345E4ad7Fff0Ec5cB41B96e69035f96DFCB8"
ETH_RPC_URL = "https://ethereum-rpc.publicnode.com"
ETH_CHAIN_ID = "1"
ETH_ESCROW_ADDRESS = "0x9F11DB204d7f7E8c805a67a0128898e65CF19b02"
VITE_ETH_ESCROW_ADDRESS = "0x9F11DB204d7f7E8c805a67a0128898e65CF19b02"

[[ports]]
