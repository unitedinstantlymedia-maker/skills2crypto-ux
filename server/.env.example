NODE_ENV=development
PORT=5000

# CSV of allowed origins (Netlify URL goes here for split deployments).
ALLOWED_ORIGINS=https://skills2crypto.com,https://www.skills2crypto.com

# Public URL of the deployed client (Netlify origin) — used to build
# challenge invite links (`${CLIENT_PUBLIC_URL}/challenge/<id>`). Required
# for split deploy; in single-host Replit dev it falls back to the dev
# domain automatically.
CLIENT_PUBLIC_URL=https://skills2crypto.com

# Postgres (Neon, Railway Postgres, or local). Required.
DATABASE_URL=postgresql://user:password@localhost/skills2crypto

# Upstash Redis (matchmaking + challenge state). Required.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# ===== Oracle / chain config =====
# EVM oracle private key — signs MatchOutcome auths for BSC + ETH escrows
# AND is the TX signer for the Tron oracle (pays TRX gas for gasless USDT
# deposits / settles). Hex, with or without 0x prefix.
ORACLE_PRIVATE_KEY=

# BSC
BSC_RPC_URL=
BSC_ESCROW_ADDRESS=
BSC_CHAIN_ID=56

# Ethereum mainnet
ETH_RPC_URL=
ETH_ESCROW_ADDRESS=
ETH_CHAIN_ID=1

# Tron (USDT TRC-20). Oracle pays TRX gas; auto-recouped via 0.5% gas-fund.
TRON_RPC_URL=https://api.trongrid.io
TRON_USDT_CONTRACT=TR7NHqjeKQxGTCi8q8ZY4pL8otSzgjLj6t
# Base58 address of the deployed Skills2CryptoEscrowTron contract (output of
# the truffle migration). Required — server fails fast on boot without it.
TRON_ESCROW_CONTRACT=
# Base58 address that receives the 3% platform fee on Tron settlements.
TRON_PLATFORM_WALLET=
TRON_CHAIN_ID=728126428
TRON_MIN_GAS_TRX=50

# TON
TON_RPC_URL=https://toncenter.com/api/v2/jsonRPC
TON_API_KEY=
# Bounceable EQ… address of the deployed Skills2CryptoEscrowTon contract.
# Required — tonOracle throws on boot without it.
TON_ESCROW_CONTRACT=
# 24-word mnemonic for the TON oracle wallet (signs MatchOutcome auths via
# Ed25519). Single space-separated string. Required.
TON_ORACLE_MNEMONIC=
# Friendly TON address that receives the 3% platform fee. Required.
TON_PLATFORM_WALLET=
