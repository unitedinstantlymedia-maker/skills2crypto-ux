NODE_ENV=development
PORT=5000

# CSV of allowed origins (Netlify URL goes here for split deployments).
ALLOWED_ORIGINS=https://skills2crypto.com,https://www.skills2crypto.com

# Postgres (Neon, Railway Postgres, or local). Required.
DATABASE_URL=postgresql://user:password@localhost/skills2crypto

# Upstash Redis (matchmaking + challenge state). Required.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# ===== Oracle / chain config =====
# Single key used to sign EVM + TON match auths.
ORACLE_PRIVATE_KEY=

# BSC
BSC_RPC_URL=
BSC_ESCROW_ADDRESS=
BSC_CHAIN_ID=56

# Ethereum mainnet
ETH_RPC_URL=
ETH_ESCROW_ADDRESS=
ETH_CHAIN_ID=1

# Tron (USDT TRC-20). Oracle pays TRX gas; auto-recouped via 0.5% gas-fund.
TRON_RPC_URL=https://api.trongrid.io
TRON_USDT_CONTRACT=TR7NHqjeKQxGTCi8q8ZY4pL8otSzgjLj6t
TRON_PLATFORM_WALLET=
TRON_CHAIN_ID=728126428
TRON_MIN_GAS_TRX=50

# TON
TON_RPC_URL=https://toncenter.com/api/v2/jsonRPC
TON_API_KEY=
