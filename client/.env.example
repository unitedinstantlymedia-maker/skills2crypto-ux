# Client (Vite) env. Copy to client/.env.local for local dev or set in Netlify.
# Anything prefixed with VITE_ is bundled into the public client code.

# URL of the backend API. Leave empty in local Replit dev (Express serves
# both client and API on one port). Set in Netlify when client is split.
VITE_API_BASE=

# Public URL of the deployed client (used to build tonconnect-manifest.json
# and set TonConnect manifestUrl). Required for production TonKeeper login.
VITE_PUBLIC_URL=
PUBLIC_URL=

# When false, real on-chain adapters are used. Default true for safety in
# local dev; the EscrowRouter ALSO forces false in production builds.
VITE_USE_MOCK_ESCROW=true

# Platform fee recipient cold wallet (EVM). Required for non-mock prod use.
VITE_FEE_ADDRESS=

# Reown / WalletConnect project ID (https://cloud.reown.com). Required for
# real EVM wallet connect (BSC + ETH). Without it Wagmi connectors fail.
VITE_REOWN_PROJECT_ID=

# Default EVM chain ID the client tries to use when no chain context is
# present (56 = BSC, 1 = Ethereum mainnet). Wagmi will still prompt the
# user to switch chains per-asset; this is just the boot default.
VITE_ESCROW_CHAIN_ID=56
